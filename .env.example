# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK ikut ke git.

# --- Dipakai frontend (boleh publik, ikut ter-bundle ke browser) ---
# Dashboard Supabase > Project Settings > Data API > Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Dashboard Supabase > Project Settings > API Keys > anon / publishable key
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# --- RAHASIA: hanya untuk migrasi & seed di terminal. JANGAN beri awalan VITE_ ---
# Dashboard Supabase > tombol "Connect" (atas) > Connection string > URI (Session pooler)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your_db_password@aws-0-region.pooler.supabase.com:5432/postgres
